# Server-side only. Never exposed to the browser.
# Without a key the app shows the cached packets and re-run is disabled; npm run eval refuses to run.
ANTHROPIC_API_KEY=
# Which Claude model the agent uses. Any current Claude model ID works; switch Sonnet and Opus here.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Only if your key isn't scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
